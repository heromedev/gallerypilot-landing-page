# GA4 web-stream measurement ID for the WEBSITE property only (format G-…).
# Create a dedicated property ("GP — Website") with a web stream for
# https://eromepilot.vercel.app. Never reuse the extension's Measurement
# Protocol ID or the Chrome Web Store listing stream here.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Stripe (already required by app/api/checkout/route.ts).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
